---
// Original explanatory diagrams of her real work, drawn as SVG on the server.
// Colors come from CSS custom properties on the parent: --dg-ink, --dg-box, --dg-hi.
import type { Diagram } from '../data/work';
interface Props { kind: Diagram }
const { kind } = Astro.props;
const mk = `ah-${kind}`;

const box = (x: number, y: number, w: number, h: number, label: string, sub?: string, hi = false) => `
  <rect x="${x}" y="${y}" width="${w}" height="${h}" rx="9" fill="var(${hi ? '--dg-hi' : '--dg-box'})" stroke="var(--dg-ink)" stroke-width="2"/>
  <text x="${x + w / 2}" y="${y + (sub ? h / 2 - 3 : h / 2 + 5)}" text-anchor="middle" font-size="14" font-weight="700" fill="var(--dg-ink)">${label}</text>
  ${sub ? `<text x="${x + w / 2}" y="${y + h / 2 + 14}" text-anchor="middle" font-size="11.5" fill="var(--dg-ink)" opacity=".75">${sub}</text>` : ''}`;
const arrow = (d: string) => `<path d="${d}" fill="none" stroke="var(--dg-ink)" stroke-width="2" stroke-linecap="round" marker-end="url(#${mk})"/>`;
const note = (x: number, y: number, t: string) => `<text x="${x}" y="${y}" font-size="12" font-weight="700" fill="var(--dg-ink)">${t}</text>`;

const parts: Record<Diagram, { label: string; body: string }> = {
  agent: {
    label: 'Diagram: a sales or support question goes to retrieval over source documents in Google Cloud Storage, Gemini Flash drafts the answer, and the reply includes a source link that expires in five minutes.',
    body: `${box(12, 84, 92, 52, 'Question', 'sales / support')}${arrow('M106 110 H134')}
      ${box(138, 30, 112, 52, 'Retrieve', 'source docs in GCS')}${box(138, 138, 112, 52, 'Gemini Flash', 'drafts the answer', true)}
      ${arrow('M194 84 V134')}${arrow('M252 164 H282')}${box(286, 138, 104, 52, 'Answer', '+ 5-min link')}
      ${note(138, 212, 'Retrieval-augmented, built with Flask')}`,
  },
  launches: {
    label: 'Diagram: engineering, sales, marketing and operations converge on one milestone, repeated for seven launches across the US and France.',
    body: `${['Engineering', 'Sales', 'Marketing', 'Operations'].map((t, i) => {
        const y = 34 + i * 44;
        return `<text x="12" y="${y + 4}" font-size="12.5" font-weight="700" fill="var(--dg-ink)">${t}</text>
          <path d="M100 ${y} H170 C218 ${y} 220 110 268 110" fill="none" stroke="var(--dg-ink)" stroke-width="2" stroke-linecap="round"/>`;
      }).join('')}
      <rect x="264" y="88" width="44" height="44" rx="4" transform="rotate(45 286 110)" fill="var(--dg-hi)" stroke="var(--dg-ink)" stroke-width="2"/>
      <text x="286" y="115" text-anchor="middle" font-size="14" font-weight="800" fill="var(--dg-ink)">×7</text>
      <text x="322" y="104" font-size="12.5" font-weight="700" fill="var(--dg-ink)">launches</text>
      <text x="322" y="120" font-size="12" fill="var(--dg-ink)" opacity=".75">US + France</text>
      ${note(100, 212, 'One set of milestones and dependencies')}`,
  },
  pipeline: {
    label: 'Diagram: legacy data feeds are orchestrated by Airflow into S3, processed with PySpark, and served to advisor dashboards.',
    body: `${box(10, 30, 86, 52, 'Legacy', 'data feeds')}${arrow('M98 56 H120')}${box(124, 30, 86, 52, 'Airflow', 'orchestrates', true)}
      ${arrow('M212 56 H234')}${box(238, 30, 70, 52, 'S3', 'storage')}${arrow('M273 84 V112')}
      ${box(218, 116, 110, 52, 'PySpark', 'processing', true)}${arrow('M216 142 H150')}${box(44, 116, 104, 52, 'Dashboards', 'for advisors')}
      ${note(10, 206, 'Processing time cut by more than 50%')}`,
  },
  machine: {
    label: 'Diagram: each client requirement change goes to a scope decision, then a schedule and budget check, in a loop for every revision.',
    body: `${box(20, 24, 130, 52, 'Requirement', 'changes from client')}${box(250, 24, 130, 52, 'Scope decision', 'and priority call', true)}
      ${box(125, 136, 150, 52, 'Schedule + budget', 'checked each time')}
      ${arrow('M152 50 H246')}${arrow('M315 78 C315 120 305 160 278 162')}${arrow('M122 162 C90 160 85 120 85 80')}
      <text x="200" y="110" text-anchor="middle" font-size="12" font-weight="700" fill="var(--dg-ink)">every revision</text>
      ${note(20, 212, 'Delivered on time and under budget')}`,
  },
};
const { label, body } = parts[kind];
const svg = `<svg viewBox="0 0 400 220" role="img" aria-label="${label}" class="dg">
  <defs><marker id="${mk}" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
  <path d="M1 1 L9 5 L1 9" fill="none" stroke="var(--dg-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></marker></defs>${body}</svg>`;
---
<Fragment set:html={svg} />
