---
import { Image } from 'astro:assets';
import photo from '../assets/profile-photo.png';
import Diagram from '../components/Diagram.astro';
import Story from '../components/Story.astro';
import { projects, lensIntro, toolkit } from '../data/work';
import '../styles/global.css';

const LINKEDIN = 'https://www.linkedin.com/in/vaishnavikulk/';
const title = 'Vaishnavi Kulkarni | Technical Program & Product Manager';
const description =
  'Former software engineer, now a technical program and product manager. Shipped a 0-to-1 AI agent that cut query resolution time by about 80%, aligned seven launches across the US and France, and moved legacy pipelines to AWS. Purdue M.S. Engineering Management, May 2027.';

const featured = projects.filter((p) => p.diagram);
const more = projects.filter((p) => !p.diagram);
const roleLabel = { product: 'Product', program: 'Program', project: 'Project' } as const;
---

<!doctype html>
<html lang="en" data-lens="all">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbf5ea" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect x='2' y='2' width='26' height='26' rx='4' fill='%232a2420'/%3E%3Crect x='0' y='0' width='26' height='26' rx='4' fill='%23dcd0f4' stroke='%232a2420' stroke-width='2'/%3E%3Ctext x='13' y='18' text-anchor='middle' font-family='Arial' font-weight='800' font-size='11' fill='%232a2420'%3EVK%3C/text%3E%3C/svg%3E" />
    <script is:inline>
      // A shared link like ?lens=program opens with that role highlighted.
      try {
        var l = new URLSearchParams(location.search).get('lens');
        if (l === 'product' || l === 'program' || l === 'project') document.documentElement.dataset.lens = l;
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip" href="#projects">Skip to projects</a>

    <nav class="nav" aria-label="Main">
      <div class="wrap">
        <a class="mono ol" href="#top" aria-label="Vaishnavi Kulkarni, back to top">VK</a>
        <ul>
          <li><a href="#projects">Projects</a></li>
          <li><a href="#about">About</a></li>
          <li><a href="#toolkit">Toolkit</a></li>
          <li><a href="#contact">Get in touch</a></li>
        </ul>
      </div>
    </nav>

    <main id="top">
      <section class="wrap hero" aria-labelledby="name">
        <div>
          <ul class="tags" aria-label="At a glance" style="list-style:none;padding:0;margin-top:0">
            <li class="tag ol sw-lilac"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 9l-4 3 4 3M16 9l4 3-4 3" /></svg>Ex-software engineer</li>
            <li class="tag ol sw-mint"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5L18 18M6 18l2.5-2.5M15.5 8.5L18 6" /></svg>Ships AI products</li>
            <li class="tag ol sw-butter"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 10l8-5 8 5-8 5zM8 12.5V16c0 1.5 8 1.5 8 0v-3.5" /></svg>Purdue MEM ’27</li>
            <li class="tag ol sw-peach"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="9" r="5" /><path d="M9 13.5L8 21l4-2 4 2-1-7.5" /></svg>Best paper award</li>
          </ul>
          <h1 id="name">Vaishnavi<br />Kulkarni</h1>
          <p class="role">Technical program &amp; product manager</p>
          <p class="bio">Three years as a software engineer, now running programs and products. I’ve shipped an AI agent from zero, aligned launches across two countries, and moved legacy pipelines to AWS.</p>

          <div class="lens" role="group" aria-labelledby="lens-label">
            <span id="lens-label">Show me as a</span>
            <button type="button" class="sw-mint" data-lens="product" aria-pressed="false">Product</button>
            <button type="button" class="sw-lilac" data-lens="program" aria-pressed="false">Program</button>
            <button type="button" class="sw-butter" data-lens="project" aria-pressed="false">Project</button>
          </div>
          <p class="lens-note" aria-live="polite">
            {(['all', 'product', 'program', 'project'] as const).map((k) => <span data-note={k}>{lensIntro[k]}</span>)}
          </p>
        </div>

        <div class="frame">
          <div class="bk b1 ol" aria-hidden="true"></div>
          <div class="bk b2 ol" aria-hidden="true"></div>
          <div class="ph ol">
            <Image src={photo} alt="Vaishnavi Kulkarni, smiling, in a dark blazer" widths={[360, 540, 720]} sizes="(max-width: 860px) 320px, 440px" format="webp" quality={82} loading="eager" />
          </div>
          <p class="hand" aria-hidden="true"><svg viewBox="0 0 56 46" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M50 40 C 30 40, 14 30, 8 8" /><path d="M3 16 L8 7 L15 14" /></svg>hi, that’s me!</p>
        </div>
      </section>

      <dl class="wrap stats" aria-label="In numbers">
        <div class="st ol" style="--r:-1deg"><dt><i class="sw-lilac" aria-hidden="true"></i>years in software engineering</dt><dd>3</dd></div>
        <div class="st ol" style="--r:1deg"><dt><i class="sw-butter" aria-hidden="true"></i>launches, US + France</dt><dd>7</dd></div>
        <div class="st ol" style="--r:-.6deg"><dt><i class="sw-mint" aria-hidden="true"></i>query resolution time</dt><dd>−80%</dd></div>
        <div class="st ol" style="--r:.8deg"><dt><i class="sw-sky" aria-hidden="true"></i>faster data pipelines</dt><dd>50%+</dd></div>
      </dl>

      <section class="wrap section" id="projects" aria-labelledby="projects-h">
        <div class="sh"><h2 id="projects-h">Featured projects</h2><span class="ln" aria-hidden="true"></span></div>
        <div class="cards">
          {featured.map((p) => (
            <article class="card ol" data-roles={p.roles.join(' ')}>
              <div class={`panel sw-${p.color}`}><Diagram kind={p.diagram!} /></div>
              <div class="tx">
                <div class="chips">{p.roles.map((r) => <span>{roleLabel[r]}</span>)}</div>
                <h3>{p.headline}</h3>
                <p class="meta">{p.where}, {p.year}. <b>{p.result}.</b></p>
                <Story p={p} />
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="wrap section" aria-labelledby="more-h">
        <div class="sh"><h2 id="more-h">More work</h2><span class="ln" aria-hidden="true"></span></div>
        <div class="rows">
          {more.map((p) => (
            <article class="row ol" data-roles={p.roles.join(' ')}>
              <div>
                <div class="chips">{p.roles.map((r) => <span>{roleLabel[r]}</span>)}</div>
                <h3>{p.headline}</h3>
                <p class="meta">{p.where}, {p.year}</p>
              </div>
              <span class={`res sw-${p.color}`}>{p.result}</span>
              <Story p={p} />
            </article>
          ))}
        </div>
      </section>

      <section class="wrap section" id="about" aria-labelledby="about-h">
        <div class="sh"><h2 id="about-h">About Vaishnavi</h2><span class="ln" aria-hidden="true"></span></div>
        <div class="why">
          <div class="story-text">
            <p>I started as a software engineer at Bounteous in Bangalore, building and fixing the data pipelines behind a wealth-management platform, then leading client onboarding and quality assurance on it.</p>
            <p>What I enjoyed most was being in the room where we decided what to build and why. So I went to Purdue to study engineering management, and I now work across product, program and project roles.</p>
            <p class="hand-note">I still read the pipeline underneath.</p>
          </div>
          <div class="boards boards--3">
            <div class="board ol sw-sky"><h3>Education</h3><ul><li>M.S. Engineering Management<small>Purdue University, May 2027</small></li><li>B.E. Computer Science<small>DSATM Bangalore, 2022</small></li></ul></div>
            <div class="board ol sw-rose"><h3>Recognition</h3><ul><li>Best Paper Award<small>AI-based dietician, national conference</small></li><li>Best Team Leader<small>Event management seminar, DSATM</small></li></ul></div>
            <div class="board ol sw-butter"><h3>Community</h3><ul><li>Ran a 500+ person science forum<small>250+ projects presented</small></li><li>Society of Women Engineers<small>WE25, New Orleans</small></li></ul></div>
          </div>
        </div>
      </section>

      <section class="wrap section" id="toolkit" aria-labelledby="kit-h">
        <div class="sh"><h2 id="kit-h">Toolkit</h2><span class="ln" aria-hidden="true"></span></div>
        <div class="boards">
          {toolkit.map((k) => (
            <div class={`board ol sw-${k.color}`} data-kit={k.lens}>
              <h3>{k.label}</h3>
              <ul>{k.items.map((i) => <li>{i}</li>)}</ul>
            </div>
          ))}
        </div>
      </section>

      <figure class="quote">
        <div class="wrap">
          <blockquote>“She showed a natural aptitude for translating technical challenges into practical solutions.”</blockquote>
          <figcaption>— Jayanthi Reddivari, her mentor, on LinkedIn</figcaption>
        </div>
      </figure>

      <section class="wrap contact" id="contact" aria-labelledby="contact-h">
        <h2 id="contact-h">Graduating May 2027. Let’s talk.</h2>
        <p>Open to technical program, product and project management roles. The fastest way to reach me is LinkedIn.</p>
        <a class="cta ol" href={LINKEDIN} rel="noopener">Message me on LinkedIn
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12h15M13 5l7 7-7 7" /></svg>
        </a>
      </section>
    </main>

    <footer>Vaishnavi Kulkarni · West Lafayette, Indiana · <a href={LINKEDIN} rel="noopener">LinkedIn</a></footer>

    <script>
      const root = document.documentElement;
      const buttons = [...document.querySelectorAll<HTMLButtonElement>('.lens button')];
      function setLens(lens: string) {
        root.dataset.lens = lens;
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.lens === lens)));
        try {
          const u = new URL(location.href);
          lens === 'all' ? u.searchParams.delete('lens') : u.searchParams.set('lens', lens);
          history.replaceState(null, '', u);
        } catch {}
      }
      buttons.forEach((b) =>
        b.addEventListener('click', () => setLens(root.dataset.lens === b.dataset.lens ? 'all' : b.dataset.lens!))
      );
      setLens(root.dataset.lens || 'all');
    </script>
  </body>
</html>
